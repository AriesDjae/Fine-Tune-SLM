# ===========================================================================
# Fine-Tune SLM for Medical Chatbot — .gitignore
# Git = dokumentasi (kode + catatan + hasil ringan).
# Semua artefak BERAT (dataset, model, venv) tetap di Google Drive.
# ===========================================================================

# --- Virtual environments (5 GB+) ----------------------------------------
.venv/
.venv-gpu/
venv/
env/
ENV/

# --- Datasets (di Drive, jangan di-track) ---------------------------------
Data/
processed/
processed_*/
*.jsonl
*.csv
*.xlsx
*.xls
*.parquet
*.arrow
*.npz

# --- Model / training artifacts -------------------------------------------
outputs/
checkpoints/
merged/
gguf/
llama.cpp/
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
adapter_model.*
adapter_config.json
tokenizer.model

# --- Python caches --------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Deploy webapp (arena penilaian dokter) -------------------------------
# `npx vercel` menulis id proyek & org ke sini; bukan rahasia keras, tapi tidak ada
# gunanya di repo dan bikin ribut kalau dua mesin men-deploy proyek yang sama.
.vercel/
node_modules/

# --- Secrets / credentials ------------------------------------------------
.env
.env.*
*.pem
*.key
kaggle.json
hf_token*
*credentials*.json
service_account*.json

# --- Smoke test manual webapp (Agustus 2026) ------------------------------
#     Dipakai sekali waktu menelusuri proxy webapp/api/index.py, yang kini
#     diarsipkan. Fungsinya tertutup scripts/uji_konsistensi.py.
/test_local_api.py
/tmp_proxy_smoke.py

# --- Stray screenshots / scratch images (bukan figur skripsi) -------------
/output.png
/output_preview.png
training/download*.png

# --- Binari llama.cpp lokal (42MB; unduh dari release resmi) --------------
llama_bin/

# --- Artefak run notebook (di-generate ulang tiap run) ---------------------
pilot_generations.txt

# --- Bundle unggah Overleaf (dibuat ulang dari artikel/) -------------------
/artikel*.zip

# --- Log runtime aplikasi penilaian dokter (Space arena) ------------------
#     Jejak sesi yang sesungguhnya diarsipkan ke logs/ di HF Dataset.
evaluasi_app.log

# --- Draf skripsi: repo PUBLIK -> jangan publikasikan sebelum sidang. ------
#     (Hapus baris ini bila memang ingin skripsi ikut ter-push.)
skripsi/

# --- OS / editor cruft ----------------------------------------------------
#     .vscode/settings.json memuat path absolut mesin ini, jadi tidak berguna
#     di repo; .agent_harnesses.json adalah state alat, bukan kode.
.vscode/
.agent_harnesses.json
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# ===========================================================================
# WHITELIST: hasil ringan untuk skripsi tetap di-track walau pola di atas
# meng-exclude (*.json aman; *.jsonl/*.csv di results/ di-include lagi).
# ===========================================================================
!results/
!results/**
# ...tapi dump record mentah (flagged jsonl) tetap di Drive, bukan git
results/*.jsonl
results/**/*.jsonl

# ...dan prediksi mentah eval P6 (6 file, ~20 MB) — arsip resmi di HuggingFace
# `AriesDjaenuri/p6-hasil/preds/`. Lihat results/preds_p6/README.md untuk cara tarik ulang.
results/preds_p6/preds/

# ===========================================================================
# Bank jawaban Tier 3. Teks pertanyaan = QnA Alodokter verbatim, jadi ia
# mengikuti aturan yang sama dengan Data/: tidak masuk git. Catatan
# reproduksinya ada di human_eval/bank_indeks.json (indeks saja, ter-track).
# ===========================================================================
human_eval/bank_pertanyaan.csv
hf_space_arena/bank/

# Cache GGUF yang diunduh untuk pra-generate bank (7+ GB).
.local_models/

# Daftar pertanyaan benchmark RQ3: teks Alodokter verbatim, aturan sama dengan Data/.
# Dibuat ulang kapan saja: benchmark_ondevice.py --simpan-pertanyaan
results_bench/pertanyaan_bench.json

# Paket benchmark HP dibangun ulang dari berkas repo; isinya memuat
# pertanyaan Alodokter verbatim, jadi jangan ikut di-commit.
tools/bench_hp.zip
